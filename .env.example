# Database
DATABASE_URL="postgresql://shopsmart:shopsmart@localhost:5433/shopsmart?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MCP_SERVER_URL="http://127.0.0.1:3101/mcp"
MCP_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MCP server process (defaults shown; set MCP_HOST=0.0.0.0 only inside containers/private networks)
MCP_PORT="3101"
MCP_HOST="127.0.0.1"

# Consent
PENDING_CONSENT_TTL_SECONDS="300"

# Optional LLM orchestration. Otherwise deterministic MCP orchestration is used.
# Consent is ALWAYS enforced server-side in confirm tools — never by the model alone.
# Option A: OpenAI-compatible Chat Completions
# Set LLM_PROVIDER=openai and OPENAI_API_KEY to enable.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
LLM_PROVIDER="none"

# Option B: Amazon Bedrock (AWS Builder integration)
# Set LLM_PROVIDER=bedrock. Credentials use the AWS SDK default chain:
# on EC2 attach an instance IAM role with bedrock:InvokeModel (no keys in env);
# locally use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an AWS profile.
# AWS_REGION="us-east-1"
# BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"

# Product provider: "demo" = curated catalog snapshot (default).
# "live" = real-time Amazon.in listings via SerpApi — requires a key from
# https://serpapi.com (free tier available). Server-side only; never commit it.
PRODUCT_PROVIDER="demo"
SERPAPI_API_KEY=""
